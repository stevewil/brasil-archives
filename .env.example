# Copy to .env for local development
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1

# Secrets (dev-only default; override for anything but local dev)
SECRET_KEY=dev-secret-change-me

# Database
DATABASE_URL=sqlite:///instance/brasil_archives.db

# i18n
BABEL_DEFAULT_LOCALE=en
BABEL_DEFAULT_TIMEZONE=UTC
