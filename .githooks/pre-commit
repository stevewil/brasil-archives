#!/usr/bin/env bash
# Pre-commit guard: block a commit that contains the literal value of any
# SECRET-shaped variable in a local .env* file.
#
# Why this exists: two real secrets (a DB password, a Wasabi access key)
# reached this PUBLIC repo via hand-pasted values in handoff/design docs
# before anyone noticed. .env is gitignored so secrets never face commit
# pressure; this extends that protection to every other file in the diff,
# including docs and the commit message. See the secrets-in-handoff-docs
# project memory for the incident this closes.
#
# Enable once per clone:  git config core.hooksPath .githooks
#
# Scope: only values whose VARIABLE NAME looks like a credential
# (SECRET / PASSWORD / TOKEN / *_KEY / ACCESS_KEY / API_KEY / DATABASE_URL
# / DSN / PRIVATE). Non-secret config (bucket names, endpoint URLs, locale
# strings) is ignored so legitimate doc prose doesn't trip it. Throwaway
# localhost credentials and values copied straight from .env.example are
# also skipped.
#
# Dependency-free (portable sh) so it runs the same on a fresh clone, on
# cPanel, and in CI.

set -euo pipefail

SECRET_NAME_RE='(SECRET|PASSWORD|PASSWD|_TOKEN|TOKEN_|^TOKEN$|_KEY$|_KEY_ID$|ACCESS_KEY|API_KEY|DATABASE_URL|_DSN$|PRIVATE)'

env_files=$(find . -maxdepth 2 -name '.env*' \
    ! -name '.env.example' ! -name '.env.sample' ! -name '*.template' \
    2>/dev/null || true)
[ -z "$env_files" ] && exit 0

# Values present in the committed template are placeholders, never real.
template_vals=""
[ -f .env.example ] && template_vals=$(sed -n 's/^[A-Za-z_][A-Za-z0-9_]*=//p' .env.example)

staged_diff=$(git diff --cached -U0 -- . ':(exclude).githooks/pre-commit')
[ -z "$staged_diff" ] && exit 0

hit=0
while IFS= read -r envfile; do
    [ -f "$envfile" ] || continue
    while IFS='=' read -r key value; do
        case "$key" in ''|'#'*) continue ;; esac
        # secret-shaped name only
        printf '%s' "$key" | grep -qE "$SECRET_NAME_RE" || continue
        value="${value%%$'\r'}"
        [ "${#value}" -lt 12 ] && continue
        # skip throwaway local creds and template placeholders
        case "$value" in
            *localhost*|*127.0.0.1*) continue ;;
        esac
        if [ -n "$template_vals" ] && printf '%s\n' "$template_vals" | grep -qxF -- "$value"; then
            continue
        fi
        if printf '%s' "$staged_diff" | grep -qF -- "$value"; then
            echo "pre-commit: BLOCKED - staged diff contains the literal value of" >&2
            echo "  $key (from $envfile)." >&2
            echo "  Use the variable NAME, not the value, in anything committed" >&2
            echo "  (docs, code, commit messages)." >&2
            hit=1
        fi
    done < "$envfile"
done <<< "$env_files"

if [ "$hit" -ne 0 ]; then
    echo >&2
    echo "pre-commit: fix the diff and re-commit. Real false positive only:" >&2
    echo "  git commit --no-verify" >&2
    exit 1
fi
exit 0
